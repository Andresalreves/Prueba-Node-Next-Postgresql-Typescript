# PostgreSQL Database
DATABASE_URL="postgresql://usuario:password@localhost:5432/chatbot_db?schema=public"

# Meta/Facebook - Tokens requeridos
META_PAGE_TOKEN="tu_page_access_token_aqui"
META_VERIFY_TOKEN="mi_token_seguro_123"
META_APP_SECRET="tu_app_secret_aqui"  # Opcional pero recomendado para validar firma de webhooks

# Proveedor de IA: 'groq' o 'openai' (default: groq)
AI_PROVIDER="groq"

# Groq API (Opcional - rápido y gratis)
# Obtén tu key en: https://console.groq.com/keys
GROQ_API_KEY="gsk_tu_groq_api_key_aqui"

# OpenAI (Opcional - requiere créditos)
# Obtén tu key en: https://platform.openai.com/api-keys
OPENAI_API_KEY="sk-tu_openai_api_key_aqui"

# Hugging Face (Para generación de imágenes con Stable Diffusion cuando usas GROQ)
# Obtén tu token en: https://huggingface.co/settings/tokens
HF_TOKEN="hf_tu_huggingface_token_aqui"

# Node Environment
NODE_ENV="development"
